;pacs
;https://manual.gromacs.org/documentation/2023-current/user-guide/mdp-options.html




integrator              = md
dt                      = 0.002      ; 2 fs
nsteps                  = 50000     ; 2 * 50000 = 100 ps


constraint-algorithm    = LINCS
constraints             = h-bonds


cutoff-scheme           = Verlet
pbc                     = xyz


vdwtype                 = Cut-off
rvdw                    = 1.0
coulombtype             = PME
rcoulomb                = 1.0


tcoupl                  = nose-hoover
tc-grps                 = System
tau-t                   = 2.0
ref-t                   = 300


pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau-p                   = 5.0
ref-p                   = 1.0
compressibility         = 4.5e-5
refcoord-scaling        = all


continuation            = no
gen-vel                 = yes
gen-temp                = 300
gen-seed                = -1


nstenergy               = 500
nstlog                  = 500
nstxout-compressed      = 500
